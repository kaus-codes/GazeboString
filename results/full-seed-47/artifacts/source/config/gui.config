<?xml version='1.0'?>
<window>
  <width>800</width><height>800</height>
  <menus><drawer default='false'/></menus>
  <dialog_on_exit>false</dialog_on_exit>
</window>
<plugin filename='MinimalScene' name='3D View'>
  <gz-gui><title>RGB Vision Sorting — Actual Gazebo Scene</title><property type='bool' key='showTitleBar'>false</property><property type='string' key='state'>docked</property></gz-gui>
  <engine>ogre2</engine><scene>scene</scene><ambient_light>0.5 0.5 0.5</ambient_light><background_color>0.15 0.18 0.22</background_color><camera_pose>2.2 -2.4 2.1 0 0.4 2.3</camera_pose>
</plugin>
<plugin filename='GzSceneManager' name='Scene Manager'>
  <gz-gui><property key='state' type='string'>floating</property><property key='width' type='double'>5</property><property key='height' type='double'>5</property><property key='showTitleBar' type='bool'>false</property></gz-gui>
</plugin>
<plugin filename='InteractiveViewControl' name='Interactive view control'>
  <gz-gui><property key='state' type='string'>floating</property><property key='width' type='double'>5</property><property key='height' type='double'>5</property><property key='showTitleBar' type='bool'>false</property></gz-gui>
</plugin>
